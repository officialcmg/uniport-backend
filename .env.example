# Required: Your NEAR Intents API Key
# Get one at https://partners.near-intents.org/
NEAR_API_KEY=your-near-api-key-here

# Optional: Port (default 3001)
PORT=3001

# Optional: 1Click API base URL (default: production)
ONECLICK_BASE_URL=https://1click.chaindefuser.com

# Required for EXACT_OUTPUT: named or implicit account registered with intents.near
UNIPORT_INTENTS_REFUND_ACCOUNT=refunds.uniport.near

# Optional: Neon Postgres. When set, live quotes and payment status changes are recorded.
# `neon env pull` writes both values to .env.local. Run `npm run migrate` after schema changes.
DATABASE_URL=postgresql://user:password@your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection, used only by `npm run migrate`
DATABASE_URL_UNPOOLED=postgresql://user:password@your-endpoint.region.aws.neon.tech/neondb?sslmode=require
