{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "uniport-backend",
    "main": "src/worker.ts",
    "compatibility_date": "2026-11-01",
    "workers_dev": true,
    "routes": [{ "pattern": "api.uniport.dev", "custom_domain": true }],
    "observability": { "enabled": true },
    "upload_source_maps": true,
    "vars": {
        "ONECLICK_BASE_URL": "https://1click.chaindefuser.com",
        // "on" refuses quotes from websites that send no App ID. Requests from
        // localhost and from servers are always allowed without one.
        "APP_ID_ENFORCEMENT": "off",
        // The address uniport.eth resolves to. NEAR Intents does not resolve ENS
        // names, so the address itself is used, in lowercase.
        "UNIPORT_INTENTS_REFUND_ACCOUNT": "0x2f43a54f931b95053c3dda5f4637065aa0c3c494"
    },
    "ratelimits": [
        // 100 requests per minute per IP. Only 10 and 60 second periods exist.
        {
            "name": "GLOBAL_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 100, "period": 60 }
        },
        // 600 quote requests per minute per registered app, across all its users.
        {
            "name": "APP_LIMITER",
            "namespace_id": "1002",
            "simple": { "limit": 600, "period": 60 }
        }
    ],
    "durable_objects": {
        "bindings": [
            { "name": "LIVE_QUOTE_LIMITER", "class_name": "LiveQuoteLimiter" }
        ]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveQuoteLimiter"] }]
}
