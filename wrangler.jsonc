{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "uniport-backend",
    "main": "src/worker.ts",
    "compatibility_date": "2026-11-01",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": true,
    "observability": { "enabled": true },
    "upload_source_maps": true,
    "vars": {
        "ONECLICK_BASE_URL": "https://1click.chaindefuser.com"
    },
    "hyperdrive": [
        // Create with `wrangler hyperdrive create` (see README) and paste the id here.
        // Local dev reads CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE instead.
        { "binding": "HYPERDRIVE", "id": "REPLACE_WITH_HYPERDRIVE_ID" }
    ],
    "ratelimits": [
        // 100 requests per minute per IP. Only 10 and 60 second periods exist.
        {
            "name": "GLOBAL_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 100, "period": 60 }
        }
    ],
    "durable_objects": {
        "bindings": [
            { "name": "LIVE_QUOTE_LIMITER", "class_name": "LiveQuoteLimiter" }
        ]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveQuoteLimiter"] }]
}
